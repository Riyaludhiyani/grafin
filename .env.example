# Autonomous Financial Event Market Impact Graph - Environment Configuration
# Copy this file to .env and populate your keys if using live LLM extraction.

# Optional LLM Provider Configuration ("gemini", "openai", "groq", or "none")
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=10

# Local Caching & Data Paths
DATA_CACHE_DIR=./data/market_cache
LOG_LEVEL=INFO

# Application Runtime Flags (true runs offline deterministic extraction with zero API calls)
OFFLINE_DEMO_MODE=true
